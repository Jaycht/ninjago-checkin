{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "忍者打卡",
  "version": "1.0.0",
  "identifier": "com.ninjago.checkin",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "",
    "beforeBuildCommand": ""
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "幻影忍者自主学习打卡台",
        "width": 1024,
        "height": 768,
        "fullscreen": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    },
    "android": {
      "package_name": "com.ninjago.checkin",
      "version": "1.0.0",
      "version_code": "1",
      "label": "幻影忍者学习",
      "icon": "icons/icon.png",
      "orientation": "sensor",
      "depth": 32,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ]
  }
}
